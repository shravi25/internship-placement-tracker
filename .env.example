# ==============================================================================
# Environment Configuration Template
# Project: Internship and Placement Application Tracker
# 
# Instructions:
# 1. Copy this file to '.env' in your local root directory.
# 2. Update the environment variables to match your local development environment.
# 3. DO NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Active Spring Profile (e.g., dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placement_tracker_dev
DB_URL=jdbc:mysql://localhost:3306/placement_tracker_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# Security / JWT Configuration (Placeholder for upcoming authentication module)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_placeholder
JWT_EXPIRATION_MS=86400000
